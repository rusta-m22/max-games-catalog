# Bootstrap only. Store real VKPLAY_SECRET in the hosting secret manager.
# Docker: --env-file .env.example ; plain Python does not auto-load this file.
VKPLAY_APP_ID=
VKPLAY_SECRET=
VKPLAY_BILLING_ENABLED=false
VKPLAY_ITEMDEF_IDS=
# Supports JSON or quote-free pairs: coins_500=2001,coins_1200=2002,coins_3000=2003,coins_7000=2004,starter=2005
VKPLAY_PAYMENT_HOSTS=vkplay.ru,co.vkpay.ru
TRUSTED_PROXY_IPS=
DATA_DIR=/data
PORT=8080
BIND_ADDRESS=0.0.0.0
MAX_CONCURRENT_REQUESTS=32
